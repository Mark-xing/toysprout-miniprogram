/* components/toy-card/toy-card.wxss */
/*
 * 图标一律用内联 SVG data URI（与 app.wxss 的 .star-icon 同一套约定），
 * 不使用 emoji / Unicode 符号——不同机型字体差异会让它们变形或变彩。
 * WXSS 的 url() 里不能引用 CSS 变量，故颜色直接写十六进制，并标注对应令牌值。
 */

.tcard {
  position: relative;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  transition: transform 120ms ease-out;
}
/* 按下反馈：轻微缩小。比背景变灰更接近"按压"的物理感，也是 feed 流的通用手感 */
.tcard--pressed { transform: scale(0.965); }

/* ============ 封面 ============ */
.tcard__media {
  position: relative;
  width: 100%;
  background: var(--color-surface-muted);
  overflow: hidden;
}
.tcard__media-inner { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* 占位/骨架：暖色斜向渐变，比纯灰更贴合整站的奶油色调 */
.tcard__ph {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #F8F1E6 0%, #F1E4CE 55%, #EFE0C6 100%);
}
.tcard__ph--empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; }
.tcard__ph-text { font-size: 22rpx; color: var(--color-text-tertiary); }
.tcard__ph-heart {
  width: 56rpx; height: 56rpx; opacity: 0.32;
  background-size: contain; background-repeat: no-repeat; background-position: center;
  /* 空心心形：#D6C8B0 → 令牌 --color-border-strong */
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 20.4l-1.3-1.2C5.7 14.9 2.7 12.1 2.7 8.7 2.7 6 4.9 3.8 7.6 3.8c1.6 0 3.1.7 4 2 .9-1.3 2.4-2 4-2 2.7 0 5 2.2 5 4.9 0 3.4-3 6.2-8 11.7z' fill='none' stroke='%23D6C8B0' stroke-width='1.6'/></svg>");
}

/* 图片渐显：加载完成前保持透明，避免"半张图先冒出来"的割裂感 */
.tcard__img {
  position: absolute; left: 0; top: 0;
  width: 100%; height: 100%;
  opacity: 0;
  transition: opacity 220ms ease-out;
}
.tcard__img.is-loaded { opacity: 1; }

.tcard__cond { position: absolute; top: 14rpx; left: 14rpx; }
/* 积分压在图片左下角：半透明深底，比白底胶囊在浅色照片上更清楚 */
.tcard__points {
  position: absolute; left: 14rpx; bottom: 14rpx;
  padding: 4rpx 14rpx; border-radius: 999rpx;
  font-size: 22rpx; font-weight: 600; color: #FFFFFF;
  background: rgba(51, 41, 31, 0.55);
  backdrop-filter: blur(6px);
}

/* ============ 双击"想要"的爆裂反馈 ============ */
.tcard__burst { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
.tcard__burst-heart {
  position: absolute; left: 0; top: 0; width: 160rpx; height: 160rpx;
  margin-left: -80rpx; margin-top: -80rpx;
  background-size: contain; background-repeat: no-repeat; background-position: center;
  animation: tcard-burst 700ms ease-out forwards;
  /* 实心心形：#C94324 → 令牌 --color-accent-strong */
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 20.4l-1.3-1.2C5.7 14.9 2.7 12.1 2.7 8.7 2.7 6 4.9 3.8 7.6 3.8c1.6 0 3.1.7 4 2 .9-1.3 2.4-2 4-2 2.7 0 5 2.2 5 4.9 0 3.4-3 6.2-8 11.7z' fill='%23C94324'/></svg>");
}
@keyframes tcard-burst {
  0%   { transform: scale(0.35); opacity: 0; }
  30%  { transform: scale(1.12); opacity: 1; }
  60%  { transform: scale(1); opacity: 1; }
  100% { transform: scale(1.7); opacity: 0; }
}

/* ============ 正文 ============ */
.tcard__body { padding: 18rpx 20rpx 20rpx; }
.tcard__title {
  font-size: 27rpx; font-weight: 600; line-height: 1.4; color: var(--color-text-primary);
  /* 固定 2 行：瀑布流卡片高度必须可预测，标题行数浮动会让两列长短失控 */
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden; text-overflow: ellipsis;
  min-height: 76rpx;
}
.tcard__tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin: 10rpx 0 14rpx; }
.tcard__tag {
  font-size: 20rpx; line-height: 1.4; padding: 2rpx 10rpx; border-radius: 6rpx;
  color: var(--color-text-tertiary); background: var(--color-surface-muted);
}
.tcard__tag--ship { color: var(--color-success-text); background: var(--color-success-tint); }

/* min-height 锁 44rpx = 心形 32rpx + 上下 padding 各 6rpx（右下「想要」按钮的高度）。
   自有玩具（isMine）不显示心形、只留一行只读计数，高度本来会比他人卡片矮 4rpx——
   瀑布流里两种卡片口径就不一致了（本文件顶部强调"高度必须可预测"），故锁住最小高度。 */
.tcard__foot { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 44rpx; }
.tcard__author { display: flex; align-items: center; gap: 10rpx; flex: 1; min-width: 0; }
.tcard__avatar {
  width: 40rpx; height: 40rpx; border-radius: 50%; flex-shrink: 0;
  background: var(--color-surface-sunken);
}
.tcard__avatar--ph {
  /* 默认头像：浅底 + 空心人形，避免头像缺失时出现一块纯色方块 */
  background-color: var(--color-surface-sunken);
  background-size: 60% 60%; background-repeat: no-repeat; background-position: center;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 12.2a4.1 4.1 0 100-8.2 4.1 4.1 0 000 8.2zm0 1.8c-4 0-7.2 2.1-7.2 4.7v1.9h14.4v-1.9c0-2.6-3.2-4.7-7.2-4.7z' fill='%23B8AB99'/></svg>");
}
.tcard__name {
  font-size: 22rpx; color: var(--color-text-secondary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tcard__vf {
  width: 24rpx; height: 24rpx; flex-shrink: 0;
  background-size: contain; background-repeat: no-repeat; background-position: center;
  /* 已实名：绿底白勾，对应令牌 --color-success */
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10' fill='%233E7C59'/><path d='M7.6 12.3l2.9 2.9 5.9-6' fill='none' stroke='white' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'/></svg>");
}

.tcard__want { display: flex; align-items: center; gap: 6rpx; flex-shrink: 0; padding: 6rpx 2rpx 6rpx 12rpx; }
.tcard__heart {
  width: 32rpx; height: 32rpx;
  background-size: contain; background-repeat: no-repeat; background-position: center;
  /* 空心心形：#B8AB99 → 令牌 --color-disabled */
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 20.4l-1.3-1.2C5.7 14.9 2.7 12.1 2.7 8.7 2.7 6 4.9 3.8 7.6 3.8c1.6 0 3.1.7 4 2 .9-1.3 2.4-2 4-2 2.7 0 5 2.2 5 4.9 0 3.4-3 6.2-8 11.7z' fill='none' stroke='%23B8AB99' stroke-width='1.8'/></svg>");
  transition: transform 160ms cubic-bezier(0.34, 1.56, 0.64, 1);
}
/* 选中态：实心 + 微放大，给出"点到了"的弹性反馈 */
.tcard__heart.is-on {
  transform: scale(1.12);
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 20.4l-1.3-1.2C5.7 14.9 2.7 12.1 2.7 8.7 2.7 6 4.9 3.8 7.6 3.8c1.6 0 3.1.7 4 2 .9-1.3 2.4-2 4-2 2.7 0 5 2.2 5 4.9 0 3.4-3 6.2-8 11.7z' fill='%23C94324'/></svg>");
}
.tcard__wcount { font-size: 22rpx; color: var(--color-text-tertiary); }
.tcard__wcount.is-on { color: var(--color-accent-strong); font-weight: 600; }
/* 自有玩具的只读计数：不带心形、不可点，仅告知发布者「有多少人想要」。
   与可点版本共用字号/颜色，补 flex-shrink 防止长数字把左侧作者名挤掉。 */
.tcard__wcount--self { flex-shrink: 0; }
