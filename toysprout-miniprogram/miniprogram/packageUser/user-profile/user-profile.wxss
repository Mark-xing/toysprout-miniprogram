/* packageUser/user-profile/user-profile.wxss */
.up-page { padding-bottom: 60rpx; }
.up-avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%; flex-shrink: 0;
  background: var(--color-surface-sunken);
}
.up-avatar--ph { background: var(--color-surface-sunken); }
.up-stat { flex: 1; display: flex; flex-direction: column; align-items: center; }

.up-section { margin-bottom: 24rpx; }
.up-cols { display: flex; align-items: flex-start; gap: 20rpx; }
.up-col { flex: 1; min-width: 0; }
.up-card { margin-bottom: 20rpx; }

.up-review { padding: 16rpx 0; border-bottom: 1px solid var(--color-divider); }
.up-review:last-child { border-bottom: none; }

/* 错误态文案与按钮（复用 app.wxss 的 .empty-state 居中容器） */
.up-empty__title { display: block; font-size: 30rpx; font-weight: 600; color: var(--color-text-primary); }
.up-empty__desc {
  display: block; margin: 12rpx 0 0;
  font-size: 25rpx; line-height: 1.6; color: var(--color-text-tertiary);
}
.up-empty__btn { width: 380rpx; margin: 36rpx auto 0; }
