<!-- packageUser/points-wallet/points-wallet.wxml -->
<view class="page">
  <view wx:if="{{loading}}" class="loading-state">加载中…</view>
  <view wx:else>
    <view class="card" style="text-align:center;padding:48rpx 24rpx;">
      <text class="caption text-secondary" style="display:block;margin-bottom:8rpx;">我的积分余额</text>
      <text style="font-size:72rpx;font-weight:600;color:var(--color-accent-strong);">{{balance}}</text>
      <text class="caption text-tertiary" style="display:block;margin-top:8rpx;">发布玩具可获得积分，积分可用于兑换任意在架玩具</text>
    </view>

    <view class="card" style="margin-top:20rpx;">
      <text class="h4" style="margin-bottom:24rpx;display:block;">积分流水</text>
      <view wx:if="{{ledger.length === 0}}" class="empty-state" style="padding:40rpx 0;">
        还没有积分记录，发布玩具或兑换玩具后这里会显示流水
      </view>
      <view wx:for="{{ledger}}" wx:key="id" class="ledger-row">
        <view style="flex:1;">
          <text class="body-sm">{{item.typeLabel}}</text>
          <text class="caption text-tertiary" style="display:block;">{{item.note}}</text>
          <text class="caption text-tertiary" style="display:block;">{{item.dateLabel}}</text>
        </view>
        <text class="body-sm" style="font-weight:600;color:{{item.isPositive ? 'var(--color-success)' : 'var(--color-accent-strong)'}};">
          {{item.isPositive ? '+' : ''}}{{item.delta}}
        </text>
      </view>
    </view>
  </view>
</view>
