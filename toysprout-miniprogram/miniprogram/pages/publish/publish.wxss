/* pages/publish/publish.wxss */
.publish-page { padding-bottom: 60rpx; }
.img-preview {
  position: relative; width: 200rpx; height: 200rpx; border-radius: 16rpx; overflow: hidden;
  margin: 0 16rpx 16rpx 0;
}
.img-preview__img { width: 100%; height: 100%; }
.img-preview__del {
  position: absolute; top: 4rpx; right: 4rpx; width: 44rpx; height: 44rpx; border-radius: 50%;
  background: rgba(0,0,0,0.5); color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; line-height: 1;
}
.img-add {
  width: 200rpx; height: 200rpx; border-radius: 16rpx; border: 2rpx dashed var(--color-border-strong);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx;
  color: var(--color-text-tertiary);
}
